<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background is a flat plate in the artwork's own interior tone (the
         near-black behind the honeycomb), so the foreground's outer edge is
         invisible whatever mask the launcher applies. -->
    <background android:drawable="@drawable/beevpn_icon_bg" />
    <!-- Foreground is the full official badge (golden bee in its hexagon
         frame with the زنبور wordmark), centred at 66% of the 108dp canvas
         — inside the round-mask guarantee, ring and wordmark intact. -->
    <foreground android:drawable="@drawable/beevpn_icon_fg" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
